*--==================================================*

*-- MOVE TO EGG*

*--==================================================*

**local** **function** **MoveToEgg**(CycleId)

    **local** Timeout = os.**clock**() + 30

    **while** AutoFarm.**Enabled**

        **and** AutoFarm.**Running**

        **and** AutoFarm.**CycleId** == CycleId **do**

        **if** **not** Character **or** **not** RootPart **then**

            **return** **false**

        **end**

        **local** Egg = AutoFarm.**Target**

        *-- Reacquire target whenever necessary.*

        **if** **not** Egg **or** **not** Egg.**Parent** **then**

            Egg = **AcquireTarget**()

            **if** **not** Egg **then**

                task.**wait**(0.25)

                **if** os.**clock**() > Timeout **then**

                    Timeout = os.**clock**() + 30

                **end**

                **continue**

            **end**

        **end**

        **local** Part = **GetEggPart**(Egg)

        **if** **not** Part **or** **not** Part.**Parent** **then**

            AutoFarm.**Target** = **nil**

            task.**wait**(0.1)

            **continue**

        **end**

        **local** Difference =

            Part.**Position** - RootPart.**Position**

        **local** Distance = Difference.**Magnitude**

        **if** Distance <= 5 **then**

            **return** **true**

        **end**

        **if** Distance > 10000 **then**

            AutoFarm.**Target** = **nil**

            task.**wait**(0.1)

            **continue**

        **end**

        **local** Direction = Difference.**Unit**

        **local** Speed = math.**max**(

            CFrameSpeed,

            25

        )

        **local** Step = math.**min**(

            Distance,

            Speed \* 0.03

        )

        Character:**PivotTo**(

            Character:**GetPivot**()

            + Direction \* Step

        )

        task.**wait**()

    **end**

    **return** **false**

**end**

