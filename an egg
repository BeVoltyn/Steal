            **break**

        **end**

        task.**wait**(0.05)

    **end**

    **pcall**(**function**()

        Prompt:**InputHoldEnd**()

    **end**)

    **return** **true**

**end**

*--==================================================*

*-- ONE FARM CYCLE*

*--==================================================*

**local** **function** **RunAutoFarmCycle**(CycleId)

    *-- Get a fresh target every cycle.*

    **local** Egg = **AcquireTarget**()

    **if** **not** Egg **then**

        task.**wait**(0.5)

        **return**

    **end**

    *-- Move without permanently locking onto an old*

    *-- destroyed/replaced egg reference.*

    **if** **not** **MoveToEgg**(CycleId) **then**

        AutoFarm.**Target** = **nil**

        **return**

    **end**

    **if** **not** AutoFarm.**Enabled**

        **or** **not** AutoFarm.**Running**

        **or** AutoFarm.**CycleId** \~= CycleId **then**

        **return**

    **end**

    *-- Get the prompt AFTER reaching the egg.*

    *-- This is important because the game may recreate it.*

    **local** CurrentEgg = AutoFarm.**Target**

    **local** Prompt = **FindInteractionPrompt**(CurrentEgg)

    **if** **not** Prompt **then**

        AutoFarm.**Target** = **nil**

        **return**

    **end**

    *-- Hold E.*

    **if** **not** **HoldPrompt**(Prompt, CycleId) **then**

        AutoFarm.**Target** = **nil**

        **return**

    **end**

    *-- Don't check whether the egg model disappeared.*

    *-- Continue to the destination after successful hold.*

    task.**wait**(0.2)

    *-- Ground destination.*

    **local** Ground = **FindGroundDestination**()

    **if** **not** Ground **then**

        AutoFarm.**Target** = **nil**

        **return**

    **end**

    AutoFarm.**Destination** = Ground

    *-- Glide.*

    **if** **not** **GlideToGround**(

        Ground,

        CycleId

    ) **then**

        AutoFarm.**Target** = **nil**

        AutoFarm.**Destination** = **nil**

        **return**

    **end**

    *-- Delivery.*

    **CompleteDelivery**(

        Ground,

        CycleId

    )

    AutoFarm.**Target** = **nil**

    AutoFarm.**Destination** = **nil**

**end**

*--==================================================*

*-- START AUTO FARM*

*--==================================================*

**local** **function** **StartAutoFarm**()

    **if** AutoFarm.**Running** **then**

        **return**

    **end**

    AutoFarm.**Enabled** = **true**

    AutoFarm.**Running** = **true**

    AutoFarm.**CycleId** += 1

    **local** MyCycle = AutoFarm.**CycleId**

    task.**spawn**(**function**()

        **while** AutoFarm.**Enabled**

            **and** AutoFarm.**Running**

            **and** AutoFarm.**CycleId** == MyCycle **do**

            **RunAutoFarmCycle**(MyCycle)

            task.**wait**(0.25)

        **end**

        **if** AutoFarm.**CycleId** == MyCycle **then**

            AutoFarm.**Running** = **false**

        **end**

    **end**)

**end**

*--==================================================*

*-- STOP AUTO FARM*

*--==================================================*

**local** **function** **StopAutoFarm**()

    AutoFarm.**Enabled** = **false**

    AutoFarm.**Running** = **false**

    AutoFarm.**CycleId** += 1

    AutoFarm.**Target** = **nil**

    AutoFarm.**Destination** = **nil**

**end**

